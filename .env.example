# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local al repositorio.
# Regla: ninguna clave privada lleva el prefijo NEXT_PUBLIC_ (se expone al navegador).

# URL pública del sitio (se usa para validar el origen de las peticiones a /api/leads)
SITE_URL=http://localhost:3000

# Confiar en x-forwarded-for para identificar la IP del cliente.
# Actívalo SOLO si el despliegue está detrás de un proxy/CDN de confianza que sobrescribe ese header.
TRUST_PROXY_HEADERS=false

# Rate limiting de /api/leads
LEADS_RATE_LIMIT_MAX=5
LEADS_RATE_LIMIT_WINDOW_SECONDS=600

# Opcional: Upstash Redis para rate limiting distribuido (varias instancias / serverless).
# Son secretos de servidor: sin prefijo NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: destino de los leads (CRM / webhook interno). Secreto de servidor.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
